# DE2 (Cyclone II EP2C35F672C6). Pins from Terasic DE2_Pin_Table.pdf.
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY de2_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE de2_top.v
set_global_assignment -name QIP_FILE magic_pen_sys/synthesis/magic_pen_sys.qip
set_global_assignment -name SDC_FILE magic_pen.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

# I2C lines keep a defined level when no sensor is plugged in. The sensor modules have their own pull-ups.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[0]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[2]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[4]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[6]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[10]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[12]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[14]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_0[16]

# SDRAM: use the registers in the I/O cells so the timing does not depend on placement.
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DRAM_DQ[*]
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to DRAM_*

set_location_assignment PIN_N2 -to CLOCK_50
set_location_assignment PIN_G26 -to KEY[0]
set_location_assignment PIN_N23 -to KEY[1]
set_location_assignment PIN_P23 -to KEY[2]
set_location_assignment PIN_W26 -to KEY[3]
